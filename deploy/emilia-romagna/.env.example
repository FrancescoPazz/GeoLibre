# Copy to `.env` next to docker-compose.yml. Never commit the filled-in file.

# Cesium Ion access token owning the region's terrain asset (2473055). It is
# sent to every browser — a client token, not a secret — but it is the
# deployment's own and belongs in this file, not in the repository.
GEOLIBRE_CESIUM_TOKEN=

# eGeoCoding (Normalizzatore) service credentials as `username:password`.
# Leave empty when a same-origin proxy injects them (then set
# GEOLIBRE_GEOCODER_ENDPOINT to the proxy in docker-compose.yml).
GEOLIBRE_GEOCODER_API_KEY=

# Host port to publish the geoportal on.
GEOPORTALE_PORT=8080

# 0 to run the Python sidecar (format conversion, Whitebox tools) as well.
GEOLIBRE_DISABLE_SIDECAR=1
